// FreshBiz Leads — Prisma schema (Phase 1)
// Designed so future models (imports, leads, enrichment, segments, exports)
// can be added cleanly without reworking the foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  auditLogs        AuditLog[]
  importBatches    ImportBatch[]
  businessRecords  BusinessRecord[]

  leadProfilesAssigned LeadProfile[]  @relation("LeadAssignee")
  leadProfilesCreated  LeadProfile[]  @relation("LeadCreatedBy")
  leadProfilesUpdated  LeadProfile[]  @relation("LeadUpdatedBy")
  leadNotes            LeadNote[]     @relation("LeadNoteAuthor")
  leadActivities       LeadActivity[] @relation("LeadActivityActor")
  leadTagsAdded        LeadTag[]      @relation("LeadTagAddedBy")
  tagsCreated          Tag[]          @relation("TagCreatedBy")
  savedSegments        SavedSegment[] @relation("SegmentOwner")
  enrichmentJobs       EnrichmentJob[] @relation("EnrichmentRequestedBy")
  aiJobs               AiJob[]         @relation("AiRequestedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Phase 2 — business report import system
// ---------------------------------------------------------------------------

enum ImportStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model ImportBatch {
  id               String       @id @default(cuid())
  originalFileName String
  storedFileName   String?
  fileType         String
  fileSizeBytes    Int
  checksum         String
  source           String
  reportType       String?
  status           ImportStatus @default(UPLOADED)
  totalRows        Int          @default(0)
  validRows        Int          @default(0)
  invalidRows      Int          @default(0)
  duplicateRows    Int          @default(0)
  importedRows     Int          @default(0)
  skippedRows      Int          @default(0)
  uploadedById     String
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  uploadedBy      User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  businessRecords BusinessRecord[]
  rowErrors       ImportRowError[]

  @@index([status])
  @@index([uploadedById])
  @@index([source])
  @@index([createdAt])
  @@map("import_batches")
}

model BusinessRecord {
  id                     String    @id @default(cuid())
  documentNumber         String?
  charterNumber          String?
  effectiveDate          DateTime?
  businessName           String
  normalizedBusinessName String
  consentFlag            String?
  transactionDescription String?
  entityType             String?
  filingAddressName      String?
  filingAddress1         String?
  filingAddress2         String?
  filingCity             String?
  filingState            String?
  filingZip              String?
  agentName              String?
  agentAddress1          String?
  agentAddress2          String?
  agentCity              String?
  agentState             String?
  agentZip               String?
  businessCity           String?
  county                 String?
  associateNamesRaw      String?
  source                 String
  sourceRecordHash       String
  importBatchId          String
  importedById           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  importBatch ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importedBy  User?        @relation(fields: [importedById], references: [id], onDelete: SetNull)
  leadProfile LeadProfile?

  enrichment        BusinessEnrichment?
  enrichmentLeadJobs EnrichmentLeadJob[]
  enrichmentSources EnrichmentSourceRecord[]
  websiteCrawls     WebsiteCrawlResult[]
  aiAnalyses        AiAnalysis[]
  aiOutreachDrafts  AiOutreachDraft[]
  aiLeadJobs        AiLeadJob[]

  // Concurrency-safe dedupe guard: the same source can never store two records
  // with the same stable content hash.
  @@unique([source, sourceRecordHash])
  @@index([documentNumber])
  @@index([charterNumber])
  @@index([effectiveDate])
  @@index([businessName])
  @@index([normalizedBusinessName])
  @@index([county])
  @@index([businessCity])
  @@index([sourceRecordHash])
  @@index([importBatchId])
  @@index([createdAt])
  @@map("business_records")
}

model ImportRowError {
  id            String   @id @default(cuid())
  importBatchId String
  rowNumber     Int
  rawData       Json?
  errorCode     String
  errorMessage  String
  createdAt     DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([errorCode])
  @@map("import_row_errors")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3 — lead management workflow
//
// Official filing data stays in BusinessRecord (immutable). All user-entered
// sales data lives here. A BusinessRecord has at most one LeadProfile, created
// lazily on the first sales action.
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  REVIEWING
  QUALIFIED
  CONTACT_READY
  CONTACTED
  FOLLOW_UP
  INTERESTED
  PROPOSAL
  WON
  LOST
  DISQUALIFIED
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadActivityType {
  PROFILE_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  TAG_ADDED
  TAG_REMOVED
  FOLLOW_UP_SET
  FOLLOW_UP_CLEARED
  CONTACT_UPDATED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
  RESTORED
  BULK_UPDATED
}

enum SegmentVisibility {
  PRIVATE
  SHARED
}

model LeadProfile {
  id                     String       @id @default(cuid())
  businessRecordId       String       @unique
  status                 LeadStatus   @default(NEW)
  priority               LeadPriority @default(NORMAL)
  assignedToId           String?
  primaryContactName     String?
  primaryContactTitle    String?
  primaryEmail           String?
  primaryPhone           String?
  primaryPhoneNormalized String?
  website                String?
  customIndustry         String?
  followUpAt             DateTime?
  lastContactedAt        DateTime?
  qualifiedAt            DateTime?
  disqualifiedAt         DateTime?
  disqualificationReason String?
  // Stored as integer cents to avoid floating-point currency errors.
  estimatedValueCents    Int?
  internalSummary        String?
  archivedAt             DateTime?
  preArchiveStatus       LeadStatus?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdById            String
  updatedById            String

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)
  assignedTo     User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User           @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy      User           @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  tags           LeadTag[]
  notes          LeadNote[]
  activities     LeadActivity[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([followUpAt])
  @@index([lastContactedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([primaryEmail])
  @@index([primaryPhone])
  @@index([website])
  @@map("lead_profiles")
}

model Tag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?
  color          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User      @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  leadTags  LeadTag[]

  @@index([createdById])
  @@map("tags")
}

model LeadTag {
  id            String   @id @default(cuid())
  leadProfileId String
  tagId         String
  addedById     String
  createdAt     DateTime @default(now())

  leadProfile LeadProfile @relation(fields: [leadProfileId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy     User        @relation("LeadTagAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([leadProfileId, tagId])
  @@index([tagId])
  @@map("lead_tags")
}

model LeadNote {
  id            String   @id @default(cuid())
  leadProfileId String
  authorId      String
  body          String
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leadProfile LeadProfile @relation(fields: [leadProfileId], references: [id], onDelete: Cascade)
  author      User        @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadProfileId])
  @@index([authorId])
  @@index([isPinned])
  @@map("lead_notes")
}

model LeadActivity {
  id            String           @id @default(cuid())
  leadProfileId String
  actorId       String?
  activityType  LeadActivityType
  title         String
  description   String?
  metadata      Json?
  createdAt     DateTime         @default(now())

  leadProfile LeadProfile @relation(fields: [leadProfileId], references: [id], onDelete: Cascade)
  actor       User?       @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadProfileId])
  @@index([activityType])
  @@index([createdAt])
  @@map("lead_activities")
}

model SavedSegment {
  id          String            @id @default(cuid())
  name        String
  description String?
  filters     Json
  visibility  SegmentVisibility @default(PRIVATE)
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lastUsedAt  DateTime?

  owner User @relation("SegmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([visibility])
  @@map("saved_segments")
}

// ---------------------------------------------------------------------------
// Phase 4 — external business enrichment engine
//
// Enriched data is kept separate from official filing data (BusinessRecord) and
// manual sales data (LeadProfile). Every enriched field carries source
// attribution + confidence, and higher-confidence/manual values are protected.
// ---------------------------------------------------------------------------

enum EnrichmentJobStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum EnrichmentScope {
  SELECTED_LEADS
  FILTERED_RESULTS
  IMPORT_BATCH
  SINGLE_LEAD
}

enum EnrichmentLeadStatus {
  QUEUED
  PROCESSING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
  CANCELLED
  NEEDS_REVIEW
}

enum BusinessEnrichmentStatus {
  NOT_ENRICHED
  QUEUED
  PROCESSING
  PARTIAL
  ENRICHED
  NEEDS_REVIEW
  FAILED
  STALE
}

enum WebsiteCrawlStatus {
  SUCCESS
  PARTIAL
  BLOCKED
  TIMEOUT
  FAILED
  SKIPPED
}

model EnrichmentJob {
  id                 String              @id @default(cuid())
  requestedById      String
  status             EnrichmentJobStatus @default(DRAFT)
  scope              EnrichmentScope
  providerStrategy   String
  totalLeads         Int                 @default(0)
  queuedLeads        Int                 @default(0)
  processedLeads     Int                 @default(0)
  successfulLeads    Int                 @default(0)
  partialLeads       Int                 @default(0)
  failedLeads        Int                 @default(0)
  skippedLeads       Int                 @default(0)
  estimatedCostCents Int?
  actualCostCents    Int?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  failureReason      String?
  options            Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  requestedBy User                @relation("EnrichmentRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  leadJobs    EnrichmentLeadJob[]

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("enrichment_jobs")
}

model EnrichmentLeadJob {
  id              String               @id @default(cuid())
  enrichmentJobId String
  businessRecordId String
  leadProfileId   String?
  status          EnrichmentLeadStatus @default(QUEUED)
  attemptCount    Int                  @default(0)
  providerResults Json?
  failureCode     String?
  failureMessage  String?
  startedAt       DateTime?
  completedAt     DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  enrichmentJob  EnrichmentJob  @relation(fields: [enrichmentJobId], references: [id], onDelete: Cascade)
  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)

  @@unique([enrichmentJobId, businessRecordId])
  @@index([status])
  @@index([businessRecordId])
  @@index([enrichmentJobId])
  @@index([nextRetryAt])
  @@map("enrichment_lead_jobs")
}

model BusinessEnrichment {
  id                        String                   @id @default(cuid())
  businessRecordId          String                   @unique
  website                   String?
  websiteSource             String?
  websiteConfidence         Int?
  websiteVerifiedAt         DateTime?
  phone                     String?
  normalizedPhone           String?
  phoneSource               String?
  phoneConfidence           Int?
  phoneVerifiedAt           DateTime?
  publicEmail               String?
  emailSource               String?
  emailConfidence           Int?
  emailVerifiedAt           DateTime?
  contactPageUrl            String?
  googlePlaceId             String?
  googleMapsUrl             String?
  googleBusinessName        String?
  googlePrimaryCategory     String?
  googleSecondaryCategories Json?
  googleBusinessStatus      String?
  googleRating              Float?
  googleReviewCount         Int?
  googleAddress             String?
  googleCity                String?
  googleState               String?
  googleZip                 String?
  googleLatitude            Float?
  googleLongitude           Float?
  facebookUrl               String?
  linkedinUrl               String?
  instagramUrl              String?
  xUrl                      String?
  youtubeUrl                String?
  businessCategory          String?
  enrichmentStatus          BusinessEnrichmentStatus @default(NOT_ENRICHED)
  overallConfidence         Int?
  lastEnrichedAt            DateTime?
  lastSuccessfulEnrichmentAt DateTime?
  manualReviewRequired      Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)

  @@index([enrichmentStatus])
  @@index([website])
  @@index([normalizedPhone])
  @@index([publicEmail])
  @@index([googlePlaceId])
  @@index([lastEnrichedAt])
  @@index([manualReviewRequired])
  @@map("business_enrichments")
}

model EnrichmentSourceRecord {
  id               String    @id @default(cuid())
  businessRecordId String
  enrichmentJobId  String?
  provider         String
  sourceType       String
  sourceUrl        String?
  fieldName        String
  rawValue         String?
  normalizedValue  String?
  confidence       Int
  matchReason      String?
  metadata         Json?
  retrievedAt      DateTime
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)

  @@index([businessRecordId])
  @@index([enrichmentJobId])
  @@index([provider])
  @@index([fieldName])
  @@index([retrievedAt])
  @@map("enrichment_source_records")
}

model WebsiteCrawlResult {
  id                  String             @id @default(cuid())
  businessRecordId    String
  enrichmentJobId     String?
  websiteUrl          String
  pageUrl             String
  pageType            String
  statusCode          Int?
  contentHash         String?
  title               String?
  extractedEmails     Json?
  extractedPhones     Json?
  extractedSocialLinks Json?
  extractedBusinessName String?
  extractedAddress    String?
  crawlStatus         WebsiteCrawlStatus
  errorCode           String?
  crawledAt           DateTime
  createdAt           DateTime           @default(now())

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)

  @@index([businessRecordId])
  @@index([enrichmentJobId])
  @@index([crawlStatus])
  @@index([crawledAt])
  @@map("website_crawl_results")
}

model EnrichmentUsage {
  id                 String   @id @default(cuid())
  enrichmentJobId    String?
  provider           String
  operation          String
  requestCount       Int      @default(0)
  estimatedCostCents Int      @default(0)
  actualCostCents    Int?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([enrichmentJobId])
  @@index([provider])
  @@index([createdAt])
  @@map("enrichment_usage")
}

// Single-row, admin-tunable, non-secret enrichment settings.
model EnrichmentSettings {
  id                       String   @id @default("singleton")
  dailyLeadLimit           Int      @default(500)
  maxLeadsPerJob           Int      @default(200)
  cacheDays                Int      @default(30)
  retryLimit               Int      @default(3)
  reviewConfidenceThreshold Int     @default(60)
  websiteCrawlEnabled      Boolean  @default(true)
  websitePageLimit         Int      @default(5)
  requestTimeoutMs         Int      @default(15000)
  costCeilingCents         Int      @default(0)
  updatedById              String?
  updatedAt                DateTime @updatedAt @default(now())

  @@map("enrichment_settings")
}

// ---------------------------------------------------------------------------
// Phase 5 — AI-assisted analysis layer
//
// AI outputs are recommendations (never facts), source-labeled, versioned, and
// require approval. AI never overwrites official/verified/manual data.
// ---------------------------------------------------------------------------

enum AiAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
  STALE
}

enum AiDraftType {
  COLD_EMAIL
  FOLLOW_UP_EMAIL
  LINKEDIN_MESSAGE
  CALL_OPENER
  VOICEMAIL
  SMS_DRAFT
  INTERNAL_SUMMARY
}

enum AiDraftStatus {
  GENERATED
  EDITED
  APPROVED
  REJECTED
  ARCHIVED
}

enum AiJobType {
  CLASSIFICATION
  SCORING
  RECOMMENDATIONS
  OUTREACH
  FULL_ANALYSIS
}

enum AiJobStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model AiAnalysis {
  id                         String           @id @default(cuid())
  businessRecordId           String
  leadProfileId              String?
  businessEnrichmentId       String?
  status                     AiAnalysisStatus @default(QUEUED)
  promptVersion              String
  model                      String
  inputFingerprint           String
  industry                   String?
  industryConfidence         Int?
  businessType               String?
  businessTypeConfidence     Int?
  segment                    String?
  segmentConfidence          Int?
  leadScore                  Int?
  leadScoreExplanation       String?
  priorityRecommendation     String?
  qualificationRecommendation String?
  qualificationReason        String?
  recommendedServices        Json?
  outreachAngles             Json?
  evidence                   Json
  warnings                   Json?
  rawStructuredOutput        Json?
  approvedById               String?
  approvedAt                 DateTime?
  rejectedById               String?
  rejectedAt                 DateTime?
  rejectionReason            String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  businessRecord BusinessRecord    @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)
  drafts         AiOutreachDraft[]

  @@index([businessRecordId])
  @@index([status])
  @@index([industry])
  @@index([segment])
  @@index([leadScore])
  @@index([priorityRecommendation])
  @@index([qualificationRecommendation])
  @@index([promptVersion])
  @@index([model])
  @@index([inputFingerprint])
  @@index([createdAt])
  @@index([approvedAt])
  @@map("ai_analyses")
}

model AiOutreachDraft {
  id               String        @id @default(cuid())
  businessRecordId String
  aiAnalysisId     String
  leadProfileId    String?
  draftType        AiDraftType
  tone             String
  subject          String?
  body             String
  originalBody     String
  callToAction     String?
  promptVersion    String
  model            String
  status           AiDraftStatus @default(GENERATED)
  generatedByJobId String?
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  editedById       String?
  editedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)
  aiAnalysis     AiAnalysis     @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)

  @@index([businessRecordId])
  @@index([aiAnalysisId])
  @@index([draftType])
  @@index([status])
  @@map("ai_outreach_drafts")
}

model AiJob {
  id                 String      @id @default(cuid())
  requestedById      String
  jobType            AiJobType
  status             AiJobStatus @default(DRAFT)
  scope              String
  totalLeads         Int         @default(0)
  queuedLeads        Int         @default(0)
  processedLeads     Int         @default(0)
  successfulLeads    Int         @default(0)
  reviewLeads        Int         @default(0)
  failedLeads        Int         @default(0)
  skippedLeads       Int         @default(0)
  estimatedCostCents Int?
  actualCostCents    Int?
  inputTokens        Int?
  outputTokens       Int?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  failureReason      String?
  options            Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  requestedBy User        @relation("AiRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  leadJobs    AiLeadJob[]

  @@index([status])
  @@index([jobType])
  @@index([requestedById])
  @@index([createdAt])
  @@map("ai_jobs")
}

model AiLeadJob {
  id               String    @id @default(cuid())
  aiJobId          String
  businessRecordId String
  status           String    @default("QUEUED")
  attemptCount     Int       @default(0)
  inputFingerprint String
  startedAt        DateTime?
  completedAt      DateTime?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  aiJob          AiJob          @relation(fields: [aiJobId], references: [id], onDelete: Cascade)
  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)

  @@unique([aiJobId, businessRecordId])
  @@index([status])
  @@index([businessRecordId])
  @@index([aiJobId])
  @@map("ai_lead_jobs")
}

model AiUsage {
  id                 String   @id @default(cuid())
  aiJobId            String?
  businessRecordId   String?
  provider           String
  model              String
  operation          String
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  estimatedCostCents Int      @default(0)
  actualCostCents    Int?
  createdAt          DateTime @default(now())

  @@index([aiJobId])
  @@index([businessRecordId])
  @@index([model])
  @@index([createdAt])
  @@map("ai_usage")
}

// Single-row, admin-tunable, non-secret AI settings.
model AiSettings {
  id                        String   @id @default("singleton")
  classificationModel       String   @default("gpt-4o-mini")
  outreachModel             String   @default("gpt-4o-mini")
  dailyLeadLimit            Int      @default(500)
  maxBatchSize              Int      @default(100)
  retryLimit                Int      @default(3)
  reviewConfidenceThreshold Int      @default(60)
  costCeilingCents          Int      @default(2500)
  promptVersion             String   @default("v1")
  allowedTones              Json?
  enabledDraftTypes         Json?
  aiEnabled                 Boolean  @default(true)
  updatedById               String?
  updatedAt                 DateTime @updatedAt @default(now())

  @@map("ai_settings")
}
