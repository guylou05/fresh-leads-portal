# ---------------------------------------------------------------------------
# FreshBiz Leads — environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file or real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshbiz_leads?schema=public"

# Auth.js / NextAuth secret used to sign session tokens.
# Generate one with: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL of the deployment (used by Auth.js).
# Local:      http://localhost:3000
# Production: https://your-app.up.railway.app
AUTH_URL="http://localhost:3000"

# Trust the host header (required on Railway / behind a proxy).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Initial administrator account (used only by the seed script).
# The seed script creates this ADMIN user if it does not already exist.
# ---------------------------------------------------------------------------
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL="admin@example.com"
# Minimum 10 characters. The plain-text value is NEVER logged.
ADMIN_PASSWORD="change-me-please-10chars"
