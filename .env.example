# ---------------------------------------------------------------------------
# FreshBiz Leads — environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file or real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshbiz_leads?schema=public"

# Auth.js / NextAuth secret used to sign session tokens.
# Generate one with: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL of the deployment (used by Auth.js).
# Local:      http://localhost:3000
# Production: https://your-app.up.railway.app
AUTH_URL="http://localhost:3000"

# Trust the host header (required on Railway / behind a proxy).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Initial administrator account (used only by the seed script).
# The seed script creates this ADMIN user if it does not already exist.
# ---------------------------------------------------------------------------
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL="admin@example.com"
# Minimum 10 characters. The plain-text value is NEVER logged.
ADMIN_PASSWORD="change-me-please-10chars"

# ---------------------------------------------------------------------------
# Phase 2 — business report imports
# ---------------------------------------------------------------------------
# Maximum uploaded import file size, in megabytes (default 20).
MAX_IMPORT_FILE_SIZE_MB=20

# ---------------------------------------------------------------------------
# Phase 4 — external business enrichment engine
# ---------------------------------------------------------------------------
# Redis connection for the BullMQ job queue (web enqueues, worker consumes).
REDIS_URL="redis://localhost:6379"

# Google Maps / Places API key (server-side only; NEVER exposed to the browser).
# Leave blank to disable Google Places matching (other providers still run).
GOOGLE_MAPS_API_KEY=""

# Worker + provider tuning.
ENRICHMENT_WORKER_CONCURRENCY=3
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_REQUEST_TIMEOUT_MS=15000
ENRICHMENT_DAILY_LEAD_LIMIT=500
ENRICHMENT_DEFAULT_CACHE_DAYS=30
# Stop a job once this many cents of paid usage is reached (0 = no ceiling).
ENRICHMENT_COST_CEILING_CENTS=0
# Do not hard-code Google pricing; set your negotiated per-call cost in cents
# (0 = unknown, in which case the UI shows request counts instead of a price).
GOOGLE_PLACES_COST_PER_CALL_CENTS=0

# Website crawler limits.
WEBSITE_CRAWL_ENABLED="true"
WEBSITE_CRAWL_USER_AGENT="FreshBizLeadsBot/1.0 (+https://freshbiz.example)"
WEBSITE_CRAWL_MAX_PAGES=5
WEBSITE_CRAWL_MAX_BYTES=2000000
WEBSITE_CRAWL_DELAY_MS=750
WEBSITE_CRAWL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Phase 5 — AI-assisted analysis layer
# ---------------------------------------------------------------------------
# OpenAI API key (server-side only; NEVER exposed to the browser).
# Leave blank to use the built-in deterministic "stub" model (labeled as such).
OPENAI_API_KEY=""
OPENAI_MODEL_CLASSIFICATION="gpt-4o-mini"
OPENAI_MODEL_OUTREACH="gpt-4o-mini"
AI_WORKER_CONCURRENCY=2
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_MS=30000
AI_DAILY_LEAD_LIMIT=500
AI_DEFAULT_TEMPERATURE=0.2
AI_MAX_BATCH_SIZE=100
AI_COST_CEILING_CENTS=2500
AI_PROMPT_VERSION="v1"
# Model pricing in cents per 1M tokens (do not hard-code; 0 = unknown → show token counts).
AI_INPUT_COST_PER_MTOK_CENTS=0
AI_OUTPUT_COST_PER_MTOK_CENTS=0
AI_ENABLED="true"
